---
import { useTranslations, withBase } from "../i18n/utils";
import type { Lang } from "../i18n/ui";

// The paper PDF in its two editions (EN/RU), shown as two direct links under one PDF icon —
// e.g. "📄 EN · RU". With only two languages a dropdown is overkill; two plain anchors are
// clearer and, being direct user-gesture links, open reliably in every browser (Safari
// silently blocks window.open() fired from a <select>, which the earlier version used).
// Each edition is published to the site root by the deploy job (crypto-coma-{en,ru}.pdf).
const { current } = Astro.props as { current: Lang };
const t = useTranslations(current);

const editions = [
  { code: "EN", label: "English", href: withBase("/crypto-coma-en.pdf") },
  { code: "RU", label: "Русский", href: withBase("/crypto-coma-ru.pdf") },
];
---

<span class="pdf-links">
  <span class="pdf-ico" aria-hidden="true">📄</span>
  <span class="sr-only">{t("nav.pdf")}:</span>
  {
    editions.map((e, i) => (
      <>
        {i > 0 && <span class="pdf-sep" aria-hidden="true">·</span>}
        <a href={e.href} target="_blank" rel="noopener" aria-label={`${t("nav.pdf")} — ${e.label}`}>
          {e.code}
        </a>
      </>
    ))
  }
</span>

<style>
  .pdf-links {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--sans);
    font-size: 0.85rem;
  }
  .pdf-ico {
    font-size: 0.95rem;
    opacity: 0.7;
  }
  .pdf-links a {
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .pdf-links a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .pdf-sep {
    opacity: 0.4;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
