---
import { withBase } from "../i18n/utils";

// Two separate buttons for the paper PDF, one per edition — "📄 pdf ENG" and "📄 pdf RU".
// Each opens the PDF in a new tab (target="_blank"): the browser's PDF viewer shows it there
// and offers a download. Plain anchors are direct user gestures, so they open reliably in
// every browser (Safari included). Each edition is published to the site root by the deploy
// job (crypto-coma-{en,ru}.pdf).
const editions = [
  { code: "ENG", label: "English", href: withBase("/crypto-coma-en.pdf") },
  { code: "RU", label: "Русский", href: withBase("/crypto-coma-ru.pdf") },
];
---

<span class="pdf-btns">
  {
    editions.map((e) => (
      <a
        class="pdf-btn"
        href={e.href}
        target="_blank"
        rel="noopener"
        aria-label={`Open the paper — ${e.label} PDF`}
      >
        <span aria-hidden="true">📄</span> pdf {e.code}
      </a>
    ))
  }
</span>

<style>
  .pdf-btns {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--sans);
  }
  .pdf-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.8rem;
    color: var(--ink);
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: 0.2rem 0.5rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .pdf-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
