---
// Interactive island: drag through the levels a…z (and the crypto coma) and watch the
// star notation build up — each step adds one ★ (self-power). Data comes from levels.json;
// the component hardcodes nothing. Plain client script (define:vars), no UI framework.
import { levels, cryptoComa } from "../data/levels";
import type { Lang } from "../i18n/ui";

const { lang } = Astro.props as { lang: Lang };

// Star count = position on the ladder: a→0, b→1, …, z→25, crypto coma→26.
const steps = [
  ...levels.map((l, idx) => ({
    label: l.letter,
    stars: idx,
    hint: l.scale_hint[lang] ?? l.scale_hint.en,
    value: l.value_str,
  })),
  {
    label: "ℂ⇈",
    stars: levels.length, // 26
    hint: "crypto coma = z★",
    value: cryptoComa.value_str,
  },
];

const uiDict = {
  ru: {
    title: "Соберите крипто кому",
    level: "Уровень",
    drag: "Двигайте ползунок — каждый шаг добавляет одну звёздочку ★ (самовозведение)",
    stars: "звёздочек",
  },
  en: {
    title: "Build the crypto coma",
    level: "Level",
    drag: "Drag the slider — each step adds one star ★ (a self-power)",
    stars: "stars",
  },
} as const;
const ui = (uiDict as Record<string, (typeof uiDict)["en"]>)[lang] ?? uiDict.en;
---

<section class="tower" aria-labelledby="tower-h">
  <h2 id="tower-h">{ui.title}</h2>
  <p class="tagline">{ui.drag}</p>

  <input
    id="tower-range"
    type="range"
    min="1"
    max={steps.length}
    value="1"
    step="1"
    aria-label={ui.title}
  />

  <div class="tower-readout">
    <div class="tower-label">
      <strong>{ui.level}</strong> <span id="tower-letter" class="ccoma">a</span>
      <span id="tower-count" class="tower-meta"></span>
    </div>
    <div id="tower-notation" class="tower-notation"></div>
    <div id="tower-value" class="tower-value"></div>
    <div id="tower-hint" class="tower-hint"></div>
  </div>

  <div id="tower-stack" class="tower-stack" aria-hidden="true"></div>
</section>

<script define:vars={{ steps, starsLabel: ui.stars }}>
  const range = document.getElementById("tower-range");
  const letterEl = document.getElementById("tower-letter");
  const countEl = document.getElementById("tower-count");
  const notationEl = document.getElementById("tower-notation");
  const valueEl = document.getElementById("tower-value");
  const hintEl = document.getElementById("tower-hint");
  const stackEl = document.getElementById("tower-stack");
  const MAX_TILES = 12;

  function render(i) {
    const step = steps[i - 1];
    letterEl.textContent = step.label;
    countEl.textContent = `· ${step.stars} ${starsLabel} ★`;
    notationEl.innerHTML =
      step.stars === 0
        ? "a"
        : `a<sup>★${step.stars}</sup>`;
    valueEl.textContent = step.value.length > 60 ? step.value.slice(0, 60) + "…" : step.value;
    hintEl.textContent = step.hint;

    let html = "<span class='tile base'>a</span>";
    const tiles = Math.min(step.stars, MAX_TILES);
    for (let k = 0; k < tiles; k++) html += "<span class='tile star'>★</span>";
    if (step.stars > MAX_TILES) html += `<span class='tile more'>⋯ ★${step.stars}</span>`;
    stackEl.innerHTML = html;
  }

  range.addEventListener("input", (e) => render(Number(e.target.value)));
  render(1);
</script>

<style>
  .tower {
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: #fff;
    padding: 1.25rem;
    margin: 2rem 0;
  }
  #tower-range {
    width: 100%;
    accent-color: var(--accent);
  }
  .tower-readout {
    margin-top: 0.75rem;
  }
  .tower-label {
    font-family: var(--sans);
  }
  .tower-meta {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .tower-notation {
    font-family: var(--sans);
    font-size: 1.35rem;
    font-weight: 700;
    margin: 0.35rem 0 0.15rem;
  }
  .tower-value {
    font-family: var(--sans);
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0 0 0.35rem;
    word-break: break-all;
  }
  .tower-hint {
    color: var(--muted);
    font-style: italic;
  }
  .tower-stack {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem;
    margin-top: 1rem;
  }
  .tower-stack .tile {
    font-family: var(--sans);
    font-size: 0.8rem;
    padding: 0.2rem 0.45rem;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--paper);
  }
  .tower-stack .tile.base {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
  }
  .tower-stack .tile.star {
    color: var(--accent);
    font-weight: 700;
  }
  .tower-stack .tile.more {
    border-style: dashed;
    color: var(--muted);
  }
</style>
