    work: "Ոչ մի կերպ, եթե «աշխատել» նշանակում է «գրել» կամ «հաշվել». ոչ թուղթը կհերիքի, ոչ ատոմները, ոչ ժամանակը։ Մաթեմատիկոսն աշխատում է ոչ թե թվի, այլ նրա հասցեի հետ՝ աշտարակի բարձրության, աճի արագության, քանոն դարձած օրդինալների։ Մենք համեմատում ենք ոչ թե թվերը, այլ անվերջություն փախչելու նրանց արագությունները։ Բայց արդյոք թվի հասցեով զբաղվելը նույնն է, ինչ թիվը ճանաչելը։ Մենք վստահ գրում ենք ℂ⇈՝ երբեք չտեսած այն։ Մեր ձեռքում ի՞նչ է՝ թի՞վ, թե՞ անուն։",
    existH: "Իսկ այն ընդհանրապես գոյությու՞ն ունի։",
    exist: "d-ն չի կարելի գրել, չի կարելի հաշվելով հասնել, չի կարելի պահել։ Թող Տիեզերքը մեկից սկսած հավերժ հաշվի. այն երբեք չէր հասնի d-ին։ Ո՞ր իմաստով է ուրեմն d-ն գոյություն ունենում։ Մենք այն հնարե՞լ ենք, թե՞ հայտնաբերել։ Եթե դա փաստ է աշխարհի մասին, ապա որտե՞ղ է այն գտնվում։ Եթե՝ միայն մեր գրառման մասին, ինչո՞ւ է այն ենթարկվում նույն օրենքներին, ինչ իրական թվերը։",
    cardinalityH: "«Հզորություն»",
    cardinality: "Մենք crypto coma-ն անվանում ենք «հզորություն»՝ խաղալով բառի երկու իմաստների հետ՝ «կարդինալ թիվ» և «ուժ»։ Կատակ։ Այո։ Բայց որքան երկար ես նայում այդ մակարդակներին, այնքան պակաս պարզ է դառնում, թե որտեղ է ավարտվում կատակը։",
    questionsH: "Անպատասխան հարցեր",
    disclaimerH: "Վերապահում",
    disclaimer: "Ազնիվ լինենք. crypto coma-ն վերջավոր թիվ է։ Բայց «վերջավոր» չի նշանակում «ըմբռնելի»։ Տղաները կանգ առան z-ի վրա միայն այն պատճառով, որ այբուբենը վերջացավ, ոչ թե թվերը. ամենամեծ թիվ գոյություն չունի. ամեն գագաթ էլ պարզվում է, որ աստիճան է։ Մեծերին այդ թվերը «հայտնի» են, բայց հայտնի է անունը, ոչ թե թիվը. այն ոչ ոք չի տեսել։ Ծիծաղեք երկու տղաների վրա ևս մեկ անգամ։ Այլևս այդքան ծիծաղելի չէ, ճի՞շտ է։",
    formalism: `Նշանակենք մակարդակները a…z տառերով (ընդամենը ${meta.levels})։ Շարքը սահմանվում է որպես a = 10^${meta.start_value_log10} և L(n+1) = L(n)^L(n)։ Սա տետրացիա է. աստիճանի հիմքն ինքն է աճում։`,
    magnitude: `Արդեն b = a^a = ${b.value_str}-ն անհնար է գրել թվանշաններով։ Ուստի աշխատում ենք M(n) = log10 L(n) կարգի հետ։ Crypto coma-ն տասի աստիճանային աշտարակ է՝ մոտ ${cryptoComa.tower_height} հարկ բարձրությամբ։`,
    questions: [
      "Եթե և՛ d-ն, և՛ p-ն մարդու համար «անվերջ մեծ» են, արդյոք նրանց միջև տարբերություն կա՞, թե՞ այն ապրում է միայն թղթի վրա։",
      "Թիվ, որը չի կարելի գրել, հաշվել կամ հաշվելով հասնել, — գոյությու՞ն ունի։",
      "Մենք հնարե՞լ ենք crypto coma-ն, թե՞ պատահաբար հանդիպել դրան։",
      "Թվի հասցեով աշխատելը՝ արդյոք թիվը աշխատելու հետ նո՞ւյնն է։",
      "«Քիչ է» — քիչ ինչի՞ համար։ Ի՞նչ է ավելացնում չափը, ինչը պակասում է իմաստին։",
      "Կա՞ վերջին թիվը, թե՞ մտքի առաստաղ չկա։",
      "Ինչո՞ւ է մեզ ընդհանրապես ձգում դեպի վեր այդ սանդուղքով։",
    ],
  },
} as const;
const copy = (dict as Record<string, (typeof dict)["en"]>)[lang] ?? dict.en;
---

<Base lang={lang} title={copy.title}>
  <article>
    <h1>{copy.title} <span class="ccoma">ℂ⇈</span></h1>
    <p class="lead">{copy.abstract}</p>
    <Epigraph lang={lang} id="kronecker" />

    <h2>{copy.formalismH}</h2>
    <p>{copy.formalism}</p>
    <div class="formula">
      L(n+1) = L(n)<sup>L(n)</sup>, &nbsp; a = {levels[0].value_str}<br />
      x<sup>★</sup> = x<sup>x</sup> &nbsp;→&nbsp;
      <span class="ccoma">ℂ⇈</span> = (10<sup>36</sup>)<sup>★26</sup>
    </div>
    <p>{copy.starNote}</p>

    <Figure
      src="/img/placeholders/power-tower.svg"
      alt={lang === "ru"
        ? "Восхождение к крипто коме: a → b → … → ℂ⇈"
        : "Ascent to the crypto coma: a → b → … → ℂ⇈"}
      caption={lang === "ru"
        ? "Рис. 1. Лестница уровней, восходящая к крипто коме."
        : "Fig. 1. The ladder of levels ascending to the crypto coma."}
    />

    <h2>{copy.magnitudeH}</h2>
    <p>{copy.magnitude}</p>

    <h2>{copy.diffH}</h2>
    <p>{copy.diff}</p>

    <h2>{copy.workH}</h2>
    <p>{copy.work}</p>

    <h2>{copy.existH}</h2>
    <p>{copy.exist}</p>

    <h2>{copy.cardinalityH}</h2>
    <p>{copy.cardinality}</p>

    <h2 class="rule-top">{copy.questionsH}</h2>
    <ul class="q-list">
      {copy.questions.map((q) => <li>{q}</li>)}
    </ul>
    <p>
      <a class="cta" href={path(lang, "/meditations")}>
        {lang === "ru" ? "Больше размышлений →" : "More meditations →"}
      </a>
    </p>

    <h2 class="rule-top">{copy.disclaimerH}</h2>
    <p class="closing">{copy.disclaimer}</p>
  </article>
</Base>
