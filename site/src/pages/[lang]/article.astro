---
import Base from "../../layouts/Base.astro";
import { langStaticPaths } from "../../i18n/paths";
import { useTranslations, path } from "../../i18n/utils";
import type { Lang } from "../../i18n/ui";
import { meta, levels, cryptoComa } from "../../data/levels";
import Figure from "../../components/Figure.astro";
import Epigraph from "../../components/Epigraph.astro";

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const b = levels.find((l) => l.letter === "b")!;

const dict = {
  ru: {
    title: "Крипто кома",
    abstractH: "Аннотация",
    abstract:
      "Мы вводим восходящий ряд a, b, …, z, где каждый следующий член есть предыдущий, возведённый в собственную степень, и определяем его кульминацию — крипто кому ℂ⇈ = z^z. Мы оцениваем эту величину, записываем её степенным выражением и предлагаем символ. А затем честно признаём, сколько вопросов остаётся без ответа.",
    formalismH: "Формализм",
    formalism: `Обозначим уровни буквами a…z (всего ${meta.levels}). Ряд задаётся как a = 10^${meta.start_value_log10} и L(n+1) = L(n)^L(n). Это тетрация: основание степени само растёт.`,
    starNote:
      "Короче: если x★ = xˣ, то крипто кома — это (10³⁶)★²⁶, двадцать шесть звёздочек, по одной на букву.",
    magnitudeH: "Оценка величины",
    magnitude: `Уже b = a^a = ${b.value_str} — записать цифрами невозможно. Поэтому мы работаем с порядком M(n) = log10 L(n). Крипто кома — степенная башня из десяток высотой примерно ${cryptoComa.tower_height} этажей.`,
    diffH: "Чем d отличается от p?",
    diff:
      "Оба — и d, и p — лежат за пределами всего счётного. Спросите Вселенную, спросите свои чувства, спросите почти всю математику: об обоих вы услышите один ответ — «слишком много». Разницы не почувствовать. И всё же p чудовищно больше d. Насколько? Чтобы ужать p до размеров d, пришлось бы взять от него логарифм двенадцать раз подряд. А d — это уже число, у которого число цифр в числе его цифр астрономично. При этом прибавьте d к p — и p не шелохнётся; отнимите — не заметит. В арифметике этих гигантов d есть погрешность округления. И одновременно d больше всего, что можно было бы построить из атомов Вселенной. Как удержать обе мысли разом?",
    workH: "Как с этим вообще работать?",
    work:
      "Никак — если «работать» значит «записать» или «вычислить»: не хватит ни бумаги, ни атомов, ни времени. Математик работает не с числом, а с его адресом — высотой башни, скоростью роста, ординалами как линейкой. Мы сравниваем не числа, а темпы их бегства в бесконечность. Но тогда: возиться с адресом числа — то же ли, что знать число? Мы уверенно пишем ℂ⇈, ни разу его не видев. Что у нас в руках — число или имя?",
    existH: "А оно вообще существует?",
    exist:
      "d нельзя записать, нельзя досчитать до него, нельзя хранить. Считай Вселенная от единицы вечно — она бы до d не дошла. В каком смысле d существует? Мы его придумали — или обнаружили? Если это факт о мире, то где он лежит? Если только о нашей записи — почему он подчиняется тем же законам, что и настоящие числа?",
    cardinalityH: "«Мощность»",
    cardinality:
      "Мы называем крипто кому «мощностью», играя на двух значениях слова — «кардинальное число» и «сила». Шутка? Да. Но чем дольше смотришь на эти уровни, тем меньше понятно, где кончается шутка.",
    questionsH: "Вопросы без ответов",
    questions: [
      "Если и d, и p для человека «бесконечно большие», есть ли между ними разница — или она живёт только на бумаге?",
      "Число, которое нельзя ни записать, ни вычислить, ни досчитать, — существует ли оно?",
      "Мы придумали крипто кому — или наткнулись на неё?",
      "Работать с адресом числа — это работать с числом?",
      "«Мало» — мало для чего? Что добавляет размер, чего не хватает смыслу?",
      "Есть ли последнее число — или у мысли нет потолка?",
      "Почему нас вообще тянет вверх по этой лестнице?",
    ],
    disclaimerH: "Оговорка",
    disclaimer:
      "Честно: крипто кома — конечное число. Но «конечное» не значит «постижимое». Мальчики остановились на z лишь потому, что кончился алфавит, а не числа; наибольшего числа нет — любая вершина оказывается ступенью. Взрослым эти числа «известны» — но известно имя, а не число: его не видел никто. Посмейтесь над двумя мальчиками ещё раз. Уже не смешно, правда?",
  },
  en: {
    title: "Crypto Coma",
    abstractH: "Abstract",
    abstract:
      "We introduce an ascending series a, b, …, z where each term is the previous one raised to itself, and define its culmination — the crypto coma ℂ⇈ = z^z. We estimate the value, write it as a power expression, and propose a symbol. And then we admit, honestly, how many questions are left with no answer.",
    formalismH: "Formalism",
    formalism: `Label the levels a…z (${meta.levels} in total). The series is a = 10^${meta.start_value_log10} and L(n+1) = L(n)^L(n). This is tetration: the base of the power grows at every step.`,
    starNote:
      "In short: with x★ = xˣ, the crypto coma is (10³⁶)★²⁶ — twenty-six stars, one per letter.",
    magnitudeH: "Estimating the magnitude",
    magnitude: `Already b = a^a = ${b.value_str} — impossible to write in digits. So we work with the order M(n) = log10 L(n). The crypto coma is a base-10 power tower about ${cryptoComa.tower_height} storeys tall.`,
    diffH: "How is d different from p?",
    diff:
      "Both d and p sit past everything countable. Ask the universe, ask your senses, ask almost all of mathematics: for both you hear one answer — “too much.” You cannot feel the difference. And yet p is monstrously larger than d. By how much? To shrink p down to the size of d you would have to take its logarithm twelve times over. And d is already a number whose count of digits has a count of digits that is astronomical. Meanwhile, add d to p and p does not stir; subtract it and p does not notice. In the arithmetic of these giants d is a rounding error — and at the same time d is larger than anything you could build from the atoms of the universe. How do you hold both thoughts at once?",
    workH: "How can anyone work with these?",
    work:
      "You cannot — if “work” means “write down” or “compute”: there is not enough paper, nor atoms, nor time. A mathematician works not with the number but with its address — the height of the tower, the rate of growth, ordinals as a ruler. We compare not numbers but the speeds at which they flee to infinity. But then: is handling a number’s address the same as knowing the number? We write ℂ⇈ with confidence, having never seen it. What do we hold — a number, or a name?",
    existH: "Does it even exist?",
    exist:
      "d cannot be written, counted to, or stored. If the universe counted from one forever, it would never reach d. In what sense, then, does d exist? Did we invent it — or discover it? If it is a fact about the world, where is it kept? If only about our notation, why does it obey the same laws as ordinary numbers?",
    cardinalityH: "“Cardinality”",
    cardinality:
      "We call the crypto coma a “cardinality,” punning on a word that means both “cardinal number” and “might.” A joke? Yes. But the longer you stare at these levels, the less certain you are where the joke ends.",
    questionsH: "Questions without answers",
    questions: [
      "If both d and p are “infinitely large” to a human, is there a difference between them — or does it live only on paper?",
      "A number you can neither write, compute, nor count to — does it exist?",
      "Did we invent the crypto coma, or stumble upon it?",
      "Is working with a number’s address the same as working with the number?",
      "“Too small” — too small for what? What does size add that meaning is missing?",
      "Is there a last number — or does thought have no ceiling?",
      "Why are we drawn up this ladder at all?",
    ],
    disclaimerH: "Disclaimer",
    disclaimer:
      "Honestly: the crypto coma is a finite number. But “finite” does not mean “graspable.” The boys stopped at z only because the alphabet ran out, not the numbers; there is no largest number — every summit turns out to be a step. Adults “know” these numbers — but they know the name, not the number: no one has ever seen it. Now laugh at the two boys again. It doesn’t quite work anymore, does it?",
  },
  zh: {
    title: "Crypto Coma",
    abstract:
      "我们引入一个上升数列 a, b, …, z，其中每一项都是前一项自身的幂，并定义它的顶点——crypto coma ℂ⇈ = z^z。我们估计它的大小，用幂的表达式写出它，并为它提出一个符号。然后我们坦白：还有多少问题没有答案。",
    formalismH: "形式化",
    formalism: `把各层记为 a…z（共 ${meta.levels} 层）。数列由 a = 10^${meta.start_value_log10} 与 L(n+1) = L(n)^L(n) 给定。这就是超幂（tetration）：幂的底数每一步都在增大。`,
    starNote: "简而言之：记 x★ = xˣ，则 crypto coma 为 (10³⁶)★²⁶——二十六颗星，每个字母一颗。",
    magnitudeH: "估计其大小",
    magnitude: `仅仅 b = a^a = ${b.value_str} 就已无法用数字写出。于是我们改用其“阶” M(n) = log10 L(n)。crypto coma 是一座以 10 为底、约 ${cryptoComa.tower_height} 层高的幂塔。`,
    diffH: "d 与 p 有何不同？",
    diff:
      "d 与 p 都远在一切可数之外。去问宇宙，问你的感官，问几乎全部的数学：对二者你都只会听到同一个答案——“太多了”。你感觉不到差别。然而 p 比 d 大得骇人。大多少？要把 p 缩到 d 的大小，你得对它连取十二次对数。而 d 本身，已是一个“它的位数的位数”都大到天文数字的数。与此同时，把 d 加到 p 上，p 纹丝不动；减去 d，p 也毫无察觉。在这些巨人的算术里，d 只是舍入误差——可它同时又比你用宇宙全部原子能造出的任何东西都大。你如何同时握住这两个念头？",
    workH: "人究竟如何与它们打交道？",
    work:
      "无法——如果“打交道”意味着“写下”或“计算”：纸张不够，原子不够，时间也不够。数学家处理的不是数本身，而是它的“地址”——塔的高度、增长的速度、作为标尺的序数。我们比较的不是数，而是它们奔向无穷的速度。可这样一来：摆弄一个数的地址，等于认识这个数吗？我们从未见过 ℂ⇈，却写得如此笃定。我们手里握着的，是数，还是名字？",
    existH: "它究竟存在吗？",
    exist:
      "d 无法写出，无法数到，也无法储存。纵使宇宙从一开始永远数下去，也到不了 d。那么 d 在何种意义上存在？是我们发明了它，还是发现了它？若它是关于世界的事实，那它藏在哪里？若只是关于我们记法的事实，它又为何遵守与真实的数相同的定律？",
    cardinalityH: "“势”",
    cardinality:
      "我们把 crypto coma 称作一种“势”（мощность）——这个词兼有“基数”与“力量”之意，是个双关。玩笑吗？是的。可你越久地凝视这些层级，就越难说清玩笑在哪里终止。",
    questionsH: "没有答案的问题",
    questions: [
      "若 d 与 p 对人而言都“无穷大”，它们之间还有差别吗——还是差别只活在纸上？",
      "一个既不能写、不能算、也数不到的数——它存在吗？",
      "crypto coma 是我们发明的，还是我们撞见的？",
      "处理一个数的地址，等于处理这个数吗？",
      "“太小”——对什么而言太小？当尺寸增加时，意义缺的是什么？",
      "有最后一个数吗——还是思想没有天花板？",
      "我们究竟为何被引着，一路攀上这座梯子？",
    ],
    disclaimerH: "附注",
    disclaimer:
      "老实说：crypto coma 是个有限的数。但“有限”并不意味着“可把握”。两个男孩停在 z，只因字母用完了，而不是数用完了；根本没有最大的数——每一座顶峰，原来都只是一级台阶。大人们“知道”这些数——可他们知道的是名字，不是数：没有人真正见过它。现在，再来嘲笑这两个男孩吧。已经笑不太出来了，对吧？",
  },
  ja: {
    title: "Crypto Coma",
    abstract:
      "私たちは上昇数列 a, b, …, z を導入する。各項は前項を自分自身で累乗したものであり、その頂点を crypto coma ℂ⇈ = z^z と定める。その大きさを見積もり、累乗の式で書き表し、記号を提案する。そして正直に認める——答えのない問いが、どれほど残るかを。",
    formalismH: "形式化",
    formalism: `各段を a…z と記す（全 ${meta.levels} 段）。数列は a = 10^${meta.start_value_log10} と L(n+1) = L(n)^L(n) で定まる。これはテトレーション——累乗の底が一段ごとに自ら大きくなる。`,
    starNote: "手短に言えば：x★ = xˣ とすると、crypto coma は (10³⁶)★²⁶——星が二十六個、文字ごとに一つ。",
    magnitudeH: "大きさの見積もり",
    magnitude: `すでに b = a^a = ${b.value_str} でさえ、数字では書けない。そこで私たちは位 M(n) = log10 L(n) を扱う。crypto coma は、底 10 の、およそ ${cryptoComa.tower_height} 階建ての累乗の塔である。`,
    diffH: "d は p とどう違うのか？",
    diff:
      "d も p も、数えられるいっさいの彼方にある。宇宙に問え、己の感覚に問え、ほとんどすべての数学に問え——どちらについても返る答えは同じ、「多すぎる」。違いは感じ取れない。それでも p は d より途方もなく大きい。どれほどか？ p を d の大きさまで縮めるには、対数を十二回続けて取らねばならない。しかも d は、その桁数の桁数さえ天文学的な数なのだ。一方で、d を p に足しても p は微動だにせず、引いても気づかない。この巨人たちの算術では、d は丸め誤差にすぎない——それでいて d は、宇宙のすべての原子で作りうる何よりも大きい。この二つの考えを、どうすれば同時に抱えられるのか？",
    workH: "そもそも、どう扱えばよいのか？",
    work:
      "扱えない——「扱う」が「書き下す」か「計算する」を意味するなら。紙も、原子も、時間も足りない。数学者が扱うのは数そのものではなく、その〈住所〉である——塔の高さ、増大の速さ、ものさしとしての順序数。私たちが比べるのは数ではなく、無限へ逃げていく速さだ。だが、そうだとすれば——数の住所をいじることは、その数を知ることと同じなのか？ 私たちは ℂ⇈ を一度も見ないまま、確信をもって書く。手にしているのは、数か、それとも名前か。",
    existH: "それは本当に存在するのか？",
    exist:
      "d は書けず、そこまで数えられず、蓄えられない。宇宙が一から永遠に数え続けても、d には届かない。ならば d はいかなる意味で存在するのか。私たちはそれを発明したのか、発見したのか。もし世界についての事実なら、それはどこにあるのか。もし私たちの記法についての事実にすぎないなら、なぜ本物の数と同じ法則に従うのか。",
    cardinalityH: "「濃度」",
    cardinality:
      "私たちは crypto coma を「濃度（мощность）」と呼ぶ——「基数」と「力」の両義をかけた駄洒落だ。冗談か？ そのとおり。だが、これらの段を長く見つめるほど、その冗談がどこで終わるのか、確信は薄れていく。",
    questionsH: "答えのない問い",
    questions: [
      "d も p も人にとって「無限に大きい」なら、両者に違いはあるのか——それとも違いは紙の上にしかないのか。",
      "書くことも、計算することも、数え上げることもできない数——それは存在するのか。",
      "crypto coma を、私たちは発明したのか、偶然行き当たったのか。",
      "数の住所を扱うことは、その数を扱うことと同じか。",
      "「小さすぎる」——何にとって小さすぎるのか。大きさが増すとき、意味に欠けているものは何か。",
      "最後の数はあるのか——それとも思考に天井はないのか。",
      "そもそもなぜ私たちは、この梯子を昇るよう誘われるのか。",
