    namedH: "სახელდებული რიცხვები (1-დან ზემოთ)",
    namedIntro: "დიდი რიცხვების ნაცნობი სახელები მოკლე შკალაზე და რისთვისაა თითოეული. რაც უფრო მაღლა ადიხარ, მით უფრო ხშირად ელოდება სახელი სიდიდეს, რომელიც ჯერ არ არსებობს.",
    cUse: "რისთვისაა",
    noteNamed: "უნდეცილიონი აქ შემთხვევითი არ არის: ეს არის დონე a, საიდანაც იწყება კიბე.",
    noteReal: "თითოეული სტრიქონი — რიცხვია, რომელიც სადღაც მუშაობს. არცერთი არ აღწევს b-მდეც კი.",
    noteSeq: "ეს რიგები ყველანი უსასრულობისკენ მიექანებიან. ჩვენიც — უბრალოდ, ჩვენ მას გაჩერება და სახელი მივეცით.",
    noteLadder: "ორ მეზობელ სტრიქონს შორის არა საფეხური, არამედ უფსკრულია, ყველა ზემოთა სტრიქონზე დიდი.",
  },
  hy: {
    title: "Տեղեկատու մեծ թվերի մասին",
    intro: "Ինչ մեծ թվեր կան, ինչու են դրանք պետք, և ինչ է ճանաչում գիտությունը։ Մեր սանդուղքի b մակարդակն անգամ հետ է թողնում ամեն ինչ ֆիզիկական։",
    realH: "Իրական մեծ թվեր, որոնք ճանաչում է գիտությունը",
    seqH: "Այլ շարքեր ու բազմություններ՝ ձգվող դեպի անվերջություն",
    ladderH: "crypto coma-ի սանդուղքը (a…z)",
    cValue: "Մեծություն",
    cName: "Անուն",
    cDomain: "Որտեղ է օգտագործվում",
    cSource: "Աղբյուր",
    cLevel: "Մակարդակ",
    cNotation: "Գրառում",
    cWhat: "Արժեք",
    cScale: "Մեծության կարգ",
    beyond: "լողացող կետով թվերից դուրս",
    namedH: "Անվանված թվեր (1-ից վեր)",
    namedIntro: "Մեծ թվերի ծանոթ անունները կարճ սանդղակում և ինչի համար է յուրաքանչյուրը։ Որքան բարձր ես բարձրանում, այնքան հաճախ անունը սպասում է մի մեծության, որը դեռ գոյություն չունի։",
    cUse: "Ինչի համար է",
    noteNamed: "Ունդեցիլիոնն այստեղ պատահական չէ. դա a մակարդակն է, որտեղ սկսվում է սանդուղքը։",
    noteReal: "Ամեն տող մի թիվ է, որ ինչ-որ տեղ աշխատում է։ Դրանցից ոչ մեկը չի հասնում անգամ b-ին։",
    noteSeq: "Այս շարքերը բոլորն էլ վազում են դեպի անվերջություն։ Մերը՝ նույնպես. մենք նրան ուղղակի կանգառ ու անուն տվեցինք։",
    noteLadder: "Երկու հարևան տողերի միջև ոչ թե քայլ է, այլ անդունդ, որ մեծ է վերևի բոլոր տողերից։",
  },
} as const;
const copy = (dict as Record<string, (typeof dict)["en"]>)[lang] ?? dict.en;
---

<Base lang={lang} title={copy.title}>
  <h1>{copy.title}</h1>
  <p class="lead">{copy.intro}</p>
  <Epigraph lang={lang} id="gauss" />

  <h2>{copy.namedH}</h2>
  <p>{copy.namedIntro}</p>
  <table>
    <thead>
      <tr><th>{copy.cValue}</th><th>{copy.cName}</th><th>{copy.cUse}</th></tr>
    </thead>
    <tbody>
      {
        namedNumbers.map((n) => (
          <tr>
            <td style="white-space:nowrap">
              {n.exp >= 6 ? (
                <span>10<sup>{n.exp}</sup></span>
              ) : (
                <span>{n.value_str}</span>
              )}
            </td>
            <td>{tr(n.name, lang)}</td>
            <td>{tr(n.use, lang)}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
  <p class="note">{copy.noteNamed}</p>

  <h2 class="rule-top">{copy.realH}</h2>
  <table>
    <thead>
      <tr>
        <th>{copy.cValue}</th>
        <th>{copy.cName}</th>
        <th>{copy.cDomain}</th>
        <th>{copy.cSource}</th>
      </tr>
    </thead>
    <tbody>
      {
        refNumbers.map((r) => (
          <tr>
            <td style="white-space:nowrap">{r.value_str}</td>
            <td>{tr(r.name, lang)}</td>
            <td>{tr(r.domain, lang)}</td>
            <td class="src">{r.source}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
  <p class="note">{copy.noteReal}</p>

  <h2>{copy.seqH}</h2>
  <table>
    <thead>
      <tr><th>{copy.cName}</th><th>{copy.cDomain}</th><th>{copy.cSource}</th></tr>
    </thead>
    <tbody>
      {
        refSequences.map((s) => (
          <tr>
            <td>{tr(s.name, lang)}</td>
            <td>{tr(s.note, lang)}</td>
            <td class="src">{s.source}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
  <p class="note">{copy.noteSeq}</p>

  <h2>{copy.ladderH}</h2>
  <table>
    <thead>
      <tr>
        <th>{copy.cLevel}</th>
        <th>{copy.cNotation}</th>
        <th>{copy.cWhat}</th>
        <th>{copy.cScale}</th>
      </tr>
    </thead>
    <tbody>
      {
        levels.map((l) => (
          <tr>
            <td>{l.letter}</td>
            <td style="white-space:nowrap">
              {l.stars === 0 ? (
                <span>10<sup>36</sup></span>
              ) : (
                <span>(10<sup>36</sup>)<sup>★{l.stars}</sup></span>
              )}
            </td>
            <td style="font-family:system-ui;white-space:nowrap;max-width:14rem;overflow:hidden;text-overflow:ellipsis">
              {l.value_str}
            </td>
            <td>{l.scale_hint[lang] ?? l.scale_hint.en}</td>
          </tr>
        ))
      }
      <tr>
        <td><span class="ccoma">ℂ⇈</span></td>
        <td style="white-space:nowrap">(10<sup>36</sup>)<sup>★26</sup></td>
        <td style="font-family:system-ui">z<sup>z</sup></td>
        <td>{cryptoComa.scale_hint[lang] ?? cryptoComa.scale_hint.en}</td>
      </tr>
    </tbody>
  </table>
  <p class="note">{copy.noteLadder}</p>
</Base>

